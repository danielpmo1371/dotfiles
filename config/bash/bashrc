# ~/.bashrc - Bash configuration
# Modular design: sources shared configs from dotfiles

# ─────────────────────────────────────────────────────────────────────────────
#   Early exits
# ─────────────────────────────────────────────────────────────────────────────
# If not running interactively, don't do anything
case $- in
*i*) ;;
*) return ;;
esac

# ─────────────────────────────────────────────────────────────────────────────
#   Dotfiles location
# ─────────────────────────────────────────────────────────────────────────────
# Dynamically determine dotfiles location from symlink
if [ -L "$HOME/.bashrc" ]; then
    # Get the symlink target (not fully resolved)
    BASHRC_PATH="$(readlink "$HOME/.bashrc")"
    # Go up from config/bash/bashrc to get dotfiles root
    DOTFILES_DIR="$(dirname "$(dirname "$(dirname "$BASHRC_PATH")")")"
    export DOTFILES_DIR
else
    # Fallback to default if not symlinked
    export DOTFILES_DIR="${DOTFILES_DIR:-$HOME/repos/dotfiles}"
fi

# ─────────────────────────────────────────────────────────────────────────────
#   Bash options
# ─────────────────────────────────────────────────────────────────────────────
set -o vi             # Vi mode
IGNOREEOF=10          # ^D at the prompt won't close the shell (it's forwarded for scrolling; see config/ghostty/config)
shopt -s histappend   # Append to history file
shopt -s checkwinsize # Update LINES and COLUMNS after each command
shopt -s cdspell      # Correct minor cd spelling errors
shopt -s dirspell     # Correct directory spelling during completion
shopt -s autocd       # cd by typing a directory path (parity with zsh autocd)

# ─────────────────────────────────────────────────────────────────────────────
#   Readline keybindings
# ─────────────────────────────────────────────────────────────────────────────
# Edit the current command line in $VISUAL/$EDITOR. Readline's default binding
# for edit-and-execute-command (\C-x\C-e) lives in the emacs keymap only, which
# `set -o vi` above makes unreachable — so bind it explicitly in both vi keymaps.
# Sequence matches config/zsh/zshrc so the chord is the same in either shell
# (^X^X rather than ^X^E, which would collide with the tmux prefix C-e).
# bash's own vi-command `v` binding keeps working alongside this.
bind -m vi-insert  '"\C-x\C-x": edit-and-execute-command'
bind -m vi-command '"\C-x\C-x": edit-and-execute-command'

# ─────────────────────────────────────────────────────────────────────────────
#   History
# ─────────────────────────────────────────────────────────────────────────────
HISTCONTROL=ignoreboth # Ignore duplicates and lines starting with space
HISTSIZE=10000
HISTFILESIZE=20000

# ─────────────────────────────────────────────────────────────────────────────
#   Prompt
# ─────────────────────────────────────────────────────────────────────────────
# Detect color support
case "$TERM" in
xterm-color | *-256color) color_prompt=yes ;;
esac

if [ "$color_prompt" = yes ]; then
  PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]λ '
else
  PS1='\u@\h:\w\$ '
fi
unset color_prompt

# Set terminal title
case "$TERM" in
xterm* | rxvt*)
  PS1="\[\e]0;\u@\h: \w\a\]$PS1"
  ;;
esac

# ─────────────────────────────────────────────────────────────────────────────
#   Colors
# ─────────────────────────────────────────────────────────────────────────────
if [ -x /usr/bin/dircolors ]; then
  test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
  alias grep='grep --color=auto'
  alias fgrep='fgrep --color=auto'
  alias egrep='egrep --color=auto'
fi

# ─────────────────────────────────────────────────────────────────────────────
#   Completion
# ─────────────────────────────────────────────────────────────────────────────
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
#   Source shared configurations
# ─────────────────────────────────────────────────────────────────────────────
[[ -f "$DOTFILES_DIR/config/shell/env.sh" ]] && source "$DOTFILES_DIR/config/shell/env.sh"
[[ -f "$DOTFILES_DIR/config/shell/path.sh" ]] && source "$DOTFILES_DIR/config/shell/path.sh"
[[ -f "$DOTFILES_DIR/config/shell/aliases.sh" ]] && source "$DOTFILES_DIR/config/shell/aliases.sh"
[[ -f "$DOTFILES_DIR/config/shell/git.sh" ]] && source "$DOTFILES_DIR/config/shell/git.sh"
[[ -f "$DOTFILES_DIR/config/shell/tmux.sh" ]] && source "$DOTFILES_DIR/config/shell/tmux.sh"
[[ -f "$DOTFILES_DIR/config/shell/mcp.sh" ]] && source "$DOTFILES_DIR/config/shell/mcp.sh"
[[ -f "$DOTFILES_DIR/config/shell/secrets.sh" ]] && source "$DOTFILES_DIR/config/shell/secrets.sh"

# ─────────────────────────────────────────────────────────────────────────────
#   Bash-specific aliases
# ─────────────────────────────────────────────────────────────────────────────
alias setup='nvim ~/.bashrc'
alias reterm='source ~/.bashrc'

# ─────────────────────────────────────────────────────────────────────────────
#   Tools initialization
# ─────────────────────────────────────────────────────────────────────────────
# Zoxide (smart cd)
if command -v zoxide &>/dev/null; then
  eval "$(zoxide init bash)"
fi

# FZF
[[ -f ~/.fzf.bash ]] && source ~/.fzf.bash
eval "$(fzf --bash)"

# fzf widget keys, matching config/zsh/zshrc: Ctrl-F jumps to a directory,
# Ctrl-G pastes file paths. Alt-C is left unbound (Esc-c is the vi-mode change
# operator) and Ctrl-T is released to "new tab" muscle memory.
if declare -F fzf-file-widget >/dev/null 2>&1; then
  for _fzf_keymap in emacs-standard vi-command vi-insert; do
    bind -m "$_fzf_keymap" -x '"\C-g": fzf-file-widget'
    bind -m "$_fzf_keymap" -r '\C-t'
  done
  unset _fzf_keymap
  # Restore the readline defaults fzf had overwritten on Ctrl-T.
  bind -m emacs-standard '"\C-t": transpose-chars'
  bind -m vi-insert '"\C-t": transpose-chars'
fi
if declare -F __fzf_cd__ >/dev/null 2>&1; then
  # Macro taken verbatim from the ALT-C section of `fzf --bash`, which fzf only
  # emits when FZF_ALT_C_COMMAND is non-empty. It puts the `cd` on the command
  # line and accepts it, so the jump is recorded in history. The vi keymaps use
  # upstream's trampoline: \C-z toggles to emacs mode, runs the macro, toggles back.
  bind -m emacs-standard '"\C-f": " \C-b\C-k \C-u`__fzf_cd__`\e\C-e\C-\e(\C-m\C-y\C-h\e \C-y\ey\C-x\C-x\C-d\C-y\ey\C-_"'
  bind -m vi-command '"\C-f": "\C-z\C-f\C-z"'
  bind -m vi-insert '"\C-f": "\C-z\C-f\C-z"'
fi

# ─────────────────────────────────────────────────────────────────────────────
#   Startup display
# ─────────────────────────────────────────────────────────────────────────────
# Show startup image (uses show-start function from aliases.sh)
if type show-start &>/dev/null; then
    show-start
fi

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# Task Master aliases added on 1/3/2026
alias tm='task-master'
alias taskmaster='task-master'
alias hamster='task-master'
alias ham='task-master'

# Claude Code deferred MCP loading (added by Taskmaster)
export ENABLE_EXPERIMENTAL_MCP_CLI='true'
