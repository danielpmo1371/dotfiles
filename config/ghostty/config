custom-shader-animation = always

# No font-family: Ghostty's embedded JetBrains Mono (+ Nerd Font symbols) is the
# default on every platform, so macOS and Linux render identically with no font
# install. "SF Mono" never resolved anyway — Apple hides it from third-party apps.
font-size = 19
font-thicken = true
# theme = light:Xcode Light hc,dark:Xcode Dark hc
quick-terminal-animation-duration = 0
keybind = global:super+grave_accent=toggle_quick_terminal
cursor-style = block
shell-integration-features = no-cursor
cursor-style-blink = false
link-url = true
window-inherit-working-directory = true
window-inherit-font-size = true
window-theme = system
clipboard-trim-trailing-spaces = true
mouse-hide-while-typing = true
macos-titlebar-proxy-icon = hidden
macos-icon = custom-style
macos-icon-frame = plastic
macos-icon-ghost-color = FFFFFF
macos-icon-screen-color = 000000

# Window paddin2
window-padding-x = 20,20
window-padding-y = 20,20   

# Scrolling keybinds
# Page scrolling (standard terminal keybinds)
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down

# Line scrolling for precise control
#keybind = shift+up=scroll_line_up
#keybind = shift+down=scroll_line_down

# Jump to top/bottom of scrollback
keybind = shift+home=scroll_to_top
keybind = shift+end=scroll_to_bottom

# Alternative vim-style scrolling
keybind = ctrl+u=scroll_page_up
keybind = ctrl+d=scroll_page_down

# Configure Option key as Meta for tmux prefix
macos-option-as-alt = true

# Decrease_font_size
keybind = ctrl+-=decrease_font_size:1
keybind = alt+\=decrease_font_size:1

# SSH TERM variable Option
term = xterm-256color

# ─────────────────────────────────────────────────────────────────────────────
#   Cmd ≡ Alt: one remap line instead of a per-key adapter (Ghostty >= 1.3.0)
# ─────────────────────────────────────────────────────────────────────────────
# Physical Cmd behaves as Alt for BOTH keybind matching and input encoding,
# so Cmd+<key> emits the same ESC-prefix (meta) bytes Alt produces natively
# on Linux and Option already produces here (macos-option-as-alt). All
# SEMANTICS live in tmux.conf — the single brain — and every interactive
# shell runs inside tmux (auto-attach in config/shell/tmux.sh).
key-remap = super=alt

# macOS menu accelerators fire BEFORE the remap (documented key-remap
# caveat), so every trained Cmd key that has a default Ghostty/menu binding
# must be unbound to fall through to the remap and reach tmux as meta.
keybind = super+e=unbind
keybind = super+a=unbind
keybind = super+q=unbind
keybind = super+w=unbind
keybind = super+d=unbind
keybind = super+n=unbind
keybind = super+j=unbind
keybind = super+k=unbind

# Kernel tty semantics — literal control bytes; no shell or tmux binding can
# raise SIGINT/SIGTSTP. Bound on the POST-remap chord (alt+…), so they catch
# physical Cmd+C/Z — and now Option+C/Z too, which is deliberate. Their menu
# defaults (Copy / Undo) are unbound to release the pre-remap path.
# EOF stays on physical Ctrl+D.
keybind = super+c=unbind
keybind = super+z=unbind
keybind = alt+c=text:\x03
keybind = alt+z=text:\x1A
# Cmd+V deliberately left on its default: menu Paste fires before the remap,
# so native macOS paste survives with zero config.

# ─────────────────────────────────────────────────────────────────────────────
#   Tmux Window/Session Navigation with Cmd+Shift+h/j/k/l
# ─────────────────────────────────────────────────────────────────────────────
# Post-remap chords (alt+…): physical Cmd+Shift+<key> → Shift/Ctrl-Shift-Arrow
# escape sequences whose semantics live in tmux (window/session nav). Default
# goto_split/tab binds on these chords are shadowed by these rebinds.
# NOTE: Ghostty does not support trailing comments — anything after `text:`
# (including a `# comment`) is sent literally to the terminal.
# Shift+Left (prev window)
keybind = alt+[=text:\x1b[1;2D
# Shift+Right (next window)
keybind = alt+]=text:\x1b[1;2C
# Ctrl+Shift+Left (move window left)
keybind = alt+shift+[=text:\x1b[1;6D
# Ctrl+Shift+Right (move window right)
keybind = alt+shift+]=text:\x1b[1;6C
# Shift+Left
keybind = alt+shift+h=text:\x1b[1;2D
# Shift+Right
keybind = alt+shift+l=text:\x1b[1;2C
# Shift+Down
keybind = alt+shift+j=text:\x1b[1;2B
# Shift+Up
keybind = alt+shift+k=text:\x1b[1;2A
