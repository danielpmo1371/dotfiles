{
  "memory": {
    "type": "http",
    "url": "http://memory-mcp.hl.nuvemlabs.co.nz:8000/mcp"
  },
  "browser-network": {
    "type": "sse",
    "url": "secret:MCP_BROWSER_URL"
  },
  "azure-devops": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "@azure-devops/mcp", "secret:AZDO_ORG", "--authentication", "envvar"],
    "env": {
      "AZURE_DEVOPS_ORG_URL": "secret:AZDO_ORG_URL",
      "AZURE_DEVOPS_AUTH_METHOD": "pat",
      "AZURE_DEVOPS_PAT": "secret:AZDO_PAT",
      "AZURE_DEVOPS_DEFAULT_PROJECT": "secret:AZDO_PROJECT",
      "ADO_MCP_AUTH_TOKEN": "secret:AZDO_PAT"
    }
  }
}
