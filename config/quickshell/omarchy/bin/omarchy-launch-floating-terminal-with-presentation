#!/bin/bash

# Local replacement for Omarchy's presentation terminal (logo, gum styling,
# Done/Failed prompt): runs <command> in a floating Ghostty window and holds
# it open on the result until a key is pressed.
# Usage: omarchy-launch-floating-terminal-with-presentation <command>

cmd="$*"
# 130 is the user bailing with Ctrl-C; anything else waits for a key.
script="$cmd; code=\$?; if (( code != 130 )); then echo; if (( code == 0 )); then echo Done.; else echo \"Failed (exit \$code).\"; fi; read -rsn1 -p 'Press any key to close'; fi"

exec setsid ghostty --class=org.omarchy.terminal --title=Omarchy -e bash -c "$script"
