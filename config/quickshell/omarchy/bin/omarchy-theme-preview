#!/bin/bash

# Local (not from Omarchy): draw a theme's preview card for the theme picker.
# Omarchy ships a screenshot per theme; these are drawn from colors.toml
# instead, so a theme is one small text file and the card always matches it.
#
#   omarchy-theme-preview <theme-dir> [output.svg]   default: <theme-dir>/preview.svg
#   omarchy-theme-preview --all                      every theme in $OMARCHY_PATH/themes
#
# The card is a mock desktop: a tiled terminal with the active border, a
# floating window with the floating border, and the 16-colour palette.

set -euo pipefail

WIDTH=1600
HEIGHT=900
FONT="JetBrains Mono, Fira Code, DejaVu Sans Mono, monospace"

render() {
  local theme_dir="$1" output="$2"
  local name label
  declare -A c=()

  while IFS=$'\t' read -r key value; do
    c[$key]="$value"
  done < <(omarchy-theme-color --file "$theme_dir/colors.toml" --all)

  name=${theme_dir%/}
  name=${name##*/}
  # "tokyo-night" -> "Tokyo Night", as the picker labels it.
  label=$(printf '%s' "$name" | tr '-' ' ' | sed -E 's/(^| )([a-z])/\1\u\2/g')

  local float_border="${c[hyprland_float_border]:-${c[magenta]}}"
  # The floating card fits about 12 characters at full size.
  local title_size=64
  (( ${#label} > 12 )) && title_size=$(( 64 * 12 / ${#label} ))
  local swatches="" i x
  for i in $(seq 0 15); do
    x=$(( 120 + i * 85 ))
    swatches+="  <rect x=\"$x\" y=\"780\" width=\"70\" height=\"70\" rx=\"10\" fill=\"${c[color$i]}\"/>"$'\n'
  done

  cat >"$output" <<EOF
<svg xmlns="http://www.w3.org/2000/svg" width="$WIDTH" height="$HEIGHT" viewBox="0 0 $WIDTH $HEIGHT">
  <!-- Generated by omarchy-theme-preview from colors.toml; do not edit. -->
  <rect width="$WIDTH" height="$HEIGHT" fill="${c[darker_background]}"/>
  <rect x="40" y="40" width="1000" height="680" rx="14" fill="${c[background]}" stroke="${c[accent]}" stroke-width="6"/>
  <g font-family="$FONT" font-size="30">
    <text x="80" y="110" fill="${c[green]}">~/repos</text>
    <text x="230" y="110" fill="${c[foreground]}">git status</text>
    <text x="80" y="160" fill="${c[foreground]}">On branch</text>
    <text x="260" y="160" fill="${c[cyan]}">main</text>
    <text x="80" y="210" fill="${c[green]}">  modified:   shell.qml</text>
    <text x="80" y="260" fill="${c[red]}">  deleted:    old.conf</text>
    <text x="80" y="310" fill="${c[yellow]}">  untracked:  themes/</text>
    <text x="80" y="390" fill="${c[blue]}">fn</text>
    <text x="130" y="390" fill="${c[magenta]}">apply</text>
    <text x="230" y="390" fill="${c[foreground]}">(theme: &amp;Theme) {</text>
    <text x="120" y="440" fill="${c[muted]}">// one palette, every app</text>
    <text x="120" y="490" fill="${c[orange]:-${c[yellow]}}">render</text>
    <text x="240" y="490" fill="${c[foreground]}">(theme)</text>
    <text x="80" y="540" fill="${c[foreground]}">}</text>
    <rect x="80" y="580" width="18" height="34" fill="${c[cursor]:-${c[foreground]}}"/>
  </g>
  <rect x="1080" y="40" width="480" height="680" rx="14" fill="${c[lighter_background]}" stroke="${c[selection]}" stroke-width="3"/>
  <rect x="860" y="300" width="560" height="340" rx="14" fill="${c[dark_background]}" stroke="$float_border" stroke-width="6"/>
  <text x="900" y="400" font-family="$FONT" font-size="$title_size" font-weight="bold" fill="${c[foreground]}">$label</text>
  <text x="900" y="460" font-family="$FONT" font-size="28" fill="${c[muted]}">${c[mode]:-dark} theme</text>
  <rect x="900" y="520" width="200" height="60" rx="10" fill="${c[accent]}"/>
  <text x="1000" y="560" font-family="$FONT" font-size="26" text-anchor="middle" fill="${c[background]}">accent</text>
  <rect x="1130" y="520" width="250" height="60" rx="10" fill="none" stroke="$float_border" stroke-width="3"/>
  <text x="1255" y="560" font-family="$FONT" font-size="26" text-anchor="middle" fill="$float_border">floating</text>
$swatches</svg>
EOF
}

if [[ ${1:-} == --all ]]; then
  for theme_dir in "${OMARCHY_PATH:?OMARCHY_PATH is not set}"/themes/*/; do
    [[ -f $theme_dir/colors.toml ]] && render "$theme_dir" "$theme_dir/preview.svg"
  done
elif [[ -n ${1:-} && -f $1/colors.toml ]]; then
  render "$1" "${2:-$1/preview.svg}"
else
  echo "Usage: omarchy-theme-preview <theme-dir> [output.svg] | --all" >&2
  exit 1
fi
