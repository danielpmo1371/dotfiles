#!/bin/bash

# Local replacement for Omarchy's omarchy-theme-set, which also drives
# Omarchy's wallpapers, browser, editors and keyboard. Same name and argument,
# so the vendored theme picker calls it unchanged.
#
#   omarchy-theme-set <theme-name>      e.g. "Tokyo Night", tokyo-night, dracula
#
# A theme is a directory with colors.toml: $OMARCHY_PATH/themes/<name>, with
# ~/.config/omarchy/themes/<name> laid over it (or standing alone). The vendored
# templates render into ~/.local/state/omarchy/current/theme, then each app
# that reads from there is told to reload:
#   control hub  colours pushed over IPC (no restart)
#   Hyprland     tiled and floating borders (hyprland.lua reads the theme files)
#   Ghostty      ghostty.conf, reloaded with SIGUSR2
#   tmux         the tmux theme of the same name, if config/tmux/themes has one
# Reload failures are logged, never fatal: the theme is already in place.

set -euo pipefail

STATE_DIR="$HOME/.local/state/omarchy/current"
CURRENT_THEME="$STATE_DIR/theme"
NEXT_THEME="$STATE_DIR/next-theme"
OLD_THEME="$STATE_DIR/previous-theme"
THEME_NAME_FILE="$STATE_DIR/theme.name"
USER_THEMES="$HOME/.config/omarchy/themes"
OMARCHY_THEMES="${OMARCHY_PATH:?OMARCHY_PATH is not set}/themes"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/omarchy-theme-set.lock"
LOG_DIR="$HOME/.local/state/omarchy-hub"
LOG="$LOG_DIR/theme-set.log"
TMUX_THEME="${OMARCHY_TMUX_THEME_CMD:-$(command -v tmux-theme.sh || true)}"

# Omarchy theme name -> tmux theme name, where they differ.
declare -A TMUX_THEME_ALIASES=(
  [catppuccin]=catppuccin-mocha
  [gruvbox]=gruvbox-dark
)

log() {
  mkdir -p "$LOG_DIR"
  printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"
}

if (( $# != 1 )) || [[ -z $1 ]]; then
  echo "Usage: omarchy-theme-set <theme-name>" >&2
  exit 1
fi

# "Tokyo Night" -> tokyo-night, as Omarchy's picker labels map to directories.
name=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
if [[ $name == .* || $name == */* ]]; then
  echo "Invalid theme name: $1" >&2
  exit 1
fi
if [[ ! -d $OMARCHY_THEMES/$name && ! -d $USER_THEMES/$name ]]; then
  echo "Theme '$name' does not exist" >&2
  exit 1
fi

mkdir -p "$STATE_DIR"
exec 9>"$LOCK"
flock 9

# Stage the next theme beside the current one, then swap, so a reader never
# sees a half-written theme.
rm -rf "$NEXT_THEME"
mkdir -p "$NEXT_THEME"
[[ -d $OMARCHY_THEMES/$name ]] && cp -r "$OMARCHY_THEMES/$name/." "$NEXT_THEME/"
[[ -d $USER_THEMES/$name ]] && cp -r "$USER_THEMES/$name/." "$NEXT_THEME/"
if [[ ! -f $NEXT_THEME/colors.toml ]]; then
  echo "Theme '$name' has no colors.toml" >&2
  rm -rf "$NEXT_THEME"
  exit 1
fi

omarchy-theme-set-templates

rm -rf "$OLD_THEME"
[[ -d $CURRENT_THEME ]] && mv "$CURRENT_THEME" "$OLD_THEME"
mv "$NEXT_THEME" "$CURRENT_THEME"
rm -rf "$OLD_THEME"
printf '%s\n' "$name" >"$THEME_NAME_FILE"
flock -u 9
log "theme set: $name"

colors_b64=$(base64 -w 0 "$CURRENT_THEME/colors.toml")
shell_b64=$([[ -f $CURRENT_THEME/shell.toml ]] && base64 -w 0 "$CURRENT_THEME/shell.toml" || true)
omarchy-shell -q shell applyTheme "$colors_b64" "$shell_b64" >/dev/null 2>&1 \
  || log "control hub not reached (not running?)"

if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null 2>&1; then
  hyprctl reload >/dev/null 2>&1 || log "hyprctl reload failed"
fi

pkill -USR2 -x ghostty 2>/dev/null || true

tmux_name=${TMUX_THEME_ALIASES[$name]:-$name}
if [[ -n $TMUX_THEME && -x $TMUX_THEME ]] && "$TMUX_THEME" list 2>/dev/null | grep -qxF "$tmux_name"; then
  "$TMUX_THEME" set "$tmux_name" >/dev/null 2>&1 || log "tmux theme $tmux_name not applied"
fi
