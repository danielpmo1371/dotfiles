[Unit]
  Description=Claude Code Remote Control
  After=network-online.target
  Wants=network-online.target

  [Service]
  Type=simple
  WorkingDirectory=%h/repos
  # Interactive login shell (-i) so ~/.zshrc runs and exports PATH, secrets, AI_PROVIDER, etc.
  # A plain -l shell only reads ~/.zprofile/~/.zlogin, which don't exist here.
  ExecStart=/bin/zsh -lic 'exec %h/.local/bin/claude remote-control --name %H-repos'
  Restart=on-failure
  RestartSec=10
  # stdout is the TUI redrawing every second (~500k journal lines/day); errors go to stderr
  StandardOutput=null
  StandardError=journal

  [Install]
  WantedBy=default.target

