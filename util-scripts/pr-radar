    `Open pull requests &mdash; ${who}. Snapshot ${gen.toLocaleString(undefined, { day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" })}; ages update live. Regenerate with <span class="mono">pr-radar</span>.`;
  const seg = document.getElementById("srcSeg");
  const srcs = [["all", "All"], ["azdo", "Azure DevOps"], ["github", "GitHub"]]
    .filter(([k]) => k === "all" ? DATA.source === "all" : PRS.some(p => p.src === k));
  seg.innerHTML = srcs.map(([k, l], i) => `<button data-src="${k}" class="${i === 0 ? "on" : ""}">${l}</button>`).join("");
