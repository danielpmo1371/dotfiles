  if (azdo && gh) cells += `<div class="stat"><div class="n">${azdo} / ${gh}</div><div class="l">Azure DevOps / GitHub</div></div>`;
  if (azdo) cells += `<div class="stat attn"><div class="n">${noRev}</div><div class="l">Unapproved on AzDO</div></div>`;
  cells += `<div class="stat alert"><div class="n">${stale}</div><div class="l">Stale (&gt;90 days)</div></div>
    <div class="stat attn"><div class="n">${aging}</div><div class="l">Aging (31&ndash;90 days)</div></div>
