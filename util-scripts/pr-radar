    Math.max(...b[1].map(p => +new Date(p.created))) - Math.max(...a[1].map(p => +new Date(p.created))));
  if (state.sort === "oldest") repos.reverse();
  let html = "";
  for (const [repo, prs] of repos) {
    const { ordered, loose } = splitByStory(prs);
    html += `<div class="repo-grp"><div class="repo-h">${esc(repo)} <span class="cnt">(${prs.length})</span></div>`;
    for (const [wi, ps] of ordered)
