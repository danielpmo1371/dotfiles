<body>
<div class="wrap">
  <header>
    <div class="row">
      <h1>Open PR Radar</h1>
      <div class="seg" id="themeSeg" role="group" aria-label="Theme">
        <button data-theme-opt="light">Light</button>
        <button data-theme-opt="medium">Medium</button>
        <button data-theme-opt="dark">Dark</button>
      </div>
    </div>
    <p class="sub" id="subtitle"></p>
  </header>
  <div class="stats" id="stats"></div>
  <div class="toolbar">
    <input type="search" id="q" placeholder="Search title, repo, branch, work item&hellip;" aria-label="Search pull requests">
    <div class="seg" id="srcSeg" role="group" aria-label="Source filter"></div>
    <div class="seg" id="groupSeg" role="group" aria-label="Grouping">
      <button data-group="story">Story &rsaquo; Repo</button>
      <button data-group="repo">Repo &rsaquo; Story</button>
    </div>
    <select id="sort" aria-label="Sort order">
      <option value="oldest">Oldest first</option>
      <option value="newest" selected>Newest first</option>
    </select>
  </div>
  <div class="chips" id="chips"></div>
  <div id="list"></div>
  <footer>Age thresholds: <strong>amber</strong> &gt; 30 days, <strong>red</strong> &gt; 90 days.
    Left edge colour mirrors the worst signal on the row. Reviewer badge shows the best
    vote received (Azure DevOps only). Work-item headers come from Azure Boards.</footer>
</div>
<script>
const DATA = $DATA;
const PRS = DATA.prs, STORIES = DATA.stories || {};
PRS.forEach(p => { p.ageDays = Math.max(0, Math.floor((Date.now() - new Date(p.created).getTime()) / 86400000)); });

const state = { q: "", src: "all", project: null, sort: "newest", group: "story" };
const STRIP = /^\s*(?:US#?\s*\d{4,7}|\d{5,7})\s*[:\-]\s*/i;

function esc(s) { return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
function ageBadge(d) {
  const cls = d > 90 ? "bad" : d > 30 ? "warn" : "";
  const label = d === 0 ? "today" : d === 1 ? "1 day" : d < 60 ? d + " days" : Math.round(d / 30.44) + " months";
  return `<span class="badge age ${cls}">${label} open</span>`;
}
function reviewBadge(p) {
  if (p.src === "github") return "";
  const votes = p.reviewers.map(r => r.vote);
  if (votes.some(v => v === 10)) return `<span class="badge approved">approved</span>`;
  if (votes.some(v => v === 5)) return `<span class="badge suggestions">approved w/ suggestions</span>`;
  if (p.reviewers.length) return `<span class="badge noreview">awaiting review</span>`;
  return `<span class="badge noreview">no reviewers</span>`;
}
function rowClass(p) {
  if (p.ageDays > 90) return "stale";
  if (p.ageDays > 30) return "aging";
  if (p.draft) return "draft-pr";
  return "";
}
function prCard(p, stripped, hideRepo) {
  const title = stripped ? (p.title.replace(STRIP, "") || p.title) : p.title;
  const ref = p.src === "azdo" ? "!" + p.id : p.id;
  return `
    <a class="pr ${rowClass(p)}" href="${p.url}" target="_blank" rel="noopener">
      <div class="top">
        <span class="title">${esc(title)}</span>
        ${p.draft ? `<span class="badge draft">draft</span>` : ""}
        ${ageBadge(p.ageDays)}
        ${reviewBadge(p)}
      </div>
      <div class="meta">
        <span class="mono">${hideRepo ? ref : esc(p.repo) + " " + ref}</span>
