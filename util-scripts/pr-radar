#!/usr/bin/env python3
"""pr-radar — generate a dynamic HTML dashboard of your open pull requests.

Sources: Azure DevOps (az CLI) and GitHub (gh CLI).

Usage:
  pr-radar                          # both sources, opens the page
  pr-radar --source azdo            # Azure DevOps only
  pr-radar --source github          # GitHub only
  pr-radar --org https://dev.azure.com/other-org
  pr-radar --project "Travel Declaration" --project Platform
  pr-radar -o ~/prs.html --no-open

Auth:
  Azure DevOps uses AZURE_DEVOPS_EXT_PAT (falls back to AZDO_PAT from the
  keychain-backed secrets library). GitHub uses the gh CLI's own auth.

Identity:
  --creator defaults to $PR_RADAR_CREATOR, then `git config user.email`.
  --github-user defaults to `gh api user`.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from string import Template

WI_IN_TITLE = re.compile(r"US#\s*(\d{4,7})|^(\d{5,7})\s*[:\-]")


def die(msg):
    print(f"pr-radar: {msg}", file=sys.stderr)
    sys.exit(1)


def run(cmd, ok_fail=False):
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode != 0:
        if ok_fail:
            return None
        die(f"command failed: {' '.join(cmd)}\n{res.stderr.strip()}")
    return res.stdout


def run_json(cmd, ok_fail=False):
    out = run(cmd, ok_fail=ok_fail)
    if out is None:
        return None
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        if ok_fail:
            return None
        die(f"unparseable JSON from: {' '.join(cmd)}")


def default_azdo_org():
    cfg = Path.home() / ".azure" / "azuredevops" / "config"
    if cfg.is_file():
        for line in cfg.read_text().splitlines():
            if line.strip().startswith("organization"):
                return line.split("=", 1)[1].strip()
    return None


def default_creator():
    env = os.environ.get("PR_RADAR_CREATOR")
    if env:
        return env
    out = run(["git", "config", "user.email"], ok_fail=True)
    return out.strip() if out else None


def ensure_azdo_pat():
    if os.environ.get("AZURE_DEVOPS_EXT_PAT"):
        return
    pat = os.environ.get("AZDO_PAT")
    if pat:
        os.environ["AZURE_DEVOPS_EXT_PAT"] = pat
        return
    # Last resort: the keychain entry the secrets library manages.
    out = run(["security", "find-generic-password", "-s", "AZDO_PAT", "-w"], ok_fail=True)
    if out and out.strip():
        os.environ["AZURE_DEVOPS_EXT_PAT"] = out.strip()


def fetch_azdo(org, projects, creator):
    ensure_azdo_pat()
    if not os.environ.get("AZURE_DEVOPS_EXT_PAT"):
        die("no Azure DevOps PAT found (AZURE_DEVOPS_EXT_PAT / AZDO_PAT); "
            "run secrets-doctor AZDO_PAT")
    if not projects:
        listed = run_json(["az", "devops", "project", "list", "--org", org,
                           "--query", "value[].name", "-o", "json"])
        projects = listed or []
    prs, skipped = [], []
    for proj in projects:
        raw = run_json(["az", "repos", "pr", "list", "--status", "active",
                        "--org", org, "--project", proj, "-o", "json"], ok_fail=True)
        if raw is None:
            skipped.append(proj)
            continue
        for p in raw:
            if creator.lower() not in p["createdBy"].get("uniqueName", "").lower():
                continue
            wi = None
            m = WI_IN_TITLE.search(p["title"])
            if m:
                wi = m.group(1) or m.group(2)
            prs.append({
                "src": "azdo",
                "id": str(p["pullRequestId"]),
                "title": p["title"],
                "repo": p["repository"]["name"],
                "project": p["repository"]["project"]["name"],
                "created": p["creationDate"],
                "draft": p["isDraft"],
                "source": p["sourceRefName"].removeprefix("refs/heads/"),
                "target": p["targetRefName"].removeprefix("refs/heads/"),
                "reviewers": [{"name": r["displayName"], "vote": r["vote"]}
                              for r in p.get("reviewers") or []],
                "wi": wi,
                "url": (f"{org}/{quote(p['repository']['project']['name'])}/_git/"
                        f"{quote(p['repository']['name'])}/pullrequest/{p['pullRequestId']}"),
            })
    if skipped:
        print(f"pr-radar: skipped inaccessible project(s): {', '.join(skipped)}",
              file=sys.stderr)
    return prs


def fetch_work_items(org, ids):
    stories = {}
    for wi in sorted(ids):
        item = run_json(["az", "boards", "work-item", "show", "--id", wi,
                         "--org", org, "-o", "json"], ok_fail=True)
        if item:
            f = item.get("fields", {})
            stories[wi] = {"title": f.get("System.Title", ""),
                           "type": f.get("System.WorkItemType", ""),
                           "state": f.get("System.State", "")}
    return stories


def fetch_github(user):
    if not shutil.which("gh"):
        die("gh CLI not found")
    if not user:
        user = run(["gh", "api", "user", "--jq", ".login"]).strip()
    raw = run_json(["gh", "search", "prs", "--author", user, "--state", "open",
                    "--json", "title,url,repository,createdAt,isDraft,number"])
    return user, [{
        "src": "github",
        "id": f"#{p['number']}",
        "title": p["title"],
        "repo": p["repository"]["name"],
        "project": p["repository"]["nameWithOwner"].split("/")[0],
        "created": p["createdAt"],
        "draft": p["isDraft"],
        "source": "", "target": "", "reviewers": [], "wi": None,
        "url": p["url"],
    } for p in raw]


def quote(s):
    from urllib.parse import quote as q
    return q(s, safe="")


def build_html(data):
    return Template(TEMPLATE).safe_substitute(DATA=json.dumps(data, ensure_ascii=False))


def main():
    ap = argparse.ArgumentParser(prog="pr-radar", description=__doc__.splitlines()[0])
    ap.add_argument("--source", choices=["all", "azdo", "github"], default="all",
                    help="which PR source(s) to include (default: all)")
    ap.add_argument("--org", default=None,
                    help="Azure DevOps org URL (default: az devops configure)")
    ap.add_argument("--project", action="append", default=None,
                    help="AzDO project to scan; repeatable (default: all projects)")
    ap.add_argument("--creator", default=None,
                    help="AzDO creator email substring (default: $PR_RADAR_CREATOR "
                         "or git config user.email)")
    ap.add_argument("--github-user", default=None,
                    help="GitHub login (default: gh api user)")
    ap.add_argument("--group-by", choices=["story", "repo"], default="story",
                    help="initial AzDO grouping: story>repo or repo>story "
                         "(default: story; toggleable on the page)")
    ap.add_argument("-o", "--out", default=None,
                    help="output HTML path (default: ~/.cache/pr-radar/index.html)")
    ap.add_argument("--open", dest="open_page", action="store_true", default=True,
                    help="open the page when done (default)")
    ap.add_argument("--no-open", dest="open_page", action="store_false")
    ap.add_argument("--json", action="store_true",
                    help="print the collected PR data as JSON instead of HTML")
    args = ap.parse_args()

    prs, stories, org, gh_user, creator = [], {}, None, None, None

    if args.source in ("all", "azdo"):
        org = args.org or default_azdo_org()
        if not org:
            die("no AzDO org: pass --org or set one via az devops configure")
        creator = args.creator or default_creator()
        if not creator:
            die("no creator identity: pass --creator or set PR_RADAR_CREATOR")
        azdo = fetch_azdo(org, args.project, creator)
        prs += azdo
        stories = fetch_work_items(org, {p["wi"] for p in azdo if p["wi"]})

    if args.source in ("all", "github"):
        gh_user, gh_prs = fetch_github(args.github_user)
        prs += gh_prs

    data = {
        "generated": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "source": args.source,
        "org": org, "creator": creator, "githubUser": gh_user,
        "groupBy": args.group_by,
        "prs": prs, "stories": stories,
    }

    if args.json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return

    out = Path(args.out).expanduser() if args.out else \
        Path.home() / ".cache" / "pr-radar" / "index.html"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(build_html(data), encoding="utf-8")
    print(f"pr-radar: {len(prs)} open PRs -> {out}")

    if args.open_page:
        opener = "open" if sys.platform == "darwin" else "xdg-open"
        subprocess.run([opener, str(out)], check=False)


