     .forEach(p => counts[p.project] = (counts[p.project] || 0) + 1);
  const el = document.getElementById("chips");
  el.innerHTML = Object.entries(counts).sort((a, b) => b[1] - a[1]).map(([proj, n]) =>
    `<button class="chip ${state.project === proj ? "on" : ""}" data-proj="${esc(proj)}">${esc(proj)} <span class="cnt">${n}</span></button>`).join("");
