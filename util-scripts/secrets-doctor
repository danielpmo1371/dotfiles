#!/bin/bash
# secrets-doctor - Diagnose secret propagation without ever printing values.
#
# Checks each key across the three links of the secrets chain and reports
# where it breaks:
#   STORE    - OS secret store (nuvemlabs/secrets library, one entry per key)
#   EXPORTS  - export line in config/shell/secrets.sh
#   ENV      - variable non-empty in the invoking shell's environment
#
# Usage:
#   secrets-doctor                   # check every key secrets.sh reads from the store
#   secrets-doctor AZDO_PAT          # check specific key(s)
#   secrets-doctor PIPELINE_GUARD    # a non-exact name expands as a prefix
#
# Exit codes: 0 = chain intact for all keys, 1 = at least one break,
#             2 = usage or setup error
#
# Leak-proof by design: store presence comes from key listings (secret_list),
# exports from grep on names — no code path reads a secret's value.
#
# Run it from (or as a child of) the shell you are diagnosing: the ENV column
# reflects the environment this script inherits.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-${SCRIPT_DIR%/util-scripts}}"
EXPORTS_FILE="${SECRETS_EXPORTS_FILE:-$DOTFILES_DIR/config/shell/secrets.sh}"
SECRETS_LIB="${SECRETS_LIB:-$HOME/.local/lib/secrets/secrets.sh}"

usage() {
    sed -n '2,22p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
esac

if [[ ! -f "$EXPORTS_FILE" ]]; then
    echo "Error: exports file not found: $EXPORTS_FILE" >&2
    echo "Set SECRETS_EXPORTS_FILE or DOTFILES_DIR to override." >&2
    exit 2
fi

# Uncommented lines of the exports file, reused by every parse below
exports_src="$(grep -vE '^[[:space:]]*#' "$EXPORTS_FILE")"

# Service namespace: honor the environment, otherwise read the one the
# exports file itself uses, falling back to the library default.
if [[ -z "${SECRETS_SERVICE:-}" ]]; then
    SECRETS_SERVICE="$(grep -oE 'SECRETS_SERVICE="[^"]+"' <<<"$exports_src" | head -1 | cut -d'"' -f2)"
    SECRETS_SERVICE="${SECRETS_SERVICE:-secrets}"
fi
export SECRETS_SERVICE

# Canonical keys: every KEY the exports file reads via $(secret KEY ...)
canonical_keys="$(grep -oE '\$\(secret [A-Za-z_][A-Za-z0-9_]*' <<<"$exports_src" | awk '{print $2}' | sort -u)"

# Keys present in the secret store (names only — values are never read)
store_keys=""
store_available=0
if [[ -f "$SECRETS_LIB" ]]; then
    # shellcheck source=/dev/null
    source "$SECRETS_LIB"
    store_keys="$(secret_list 2>/dev/null | sort -u)"
    store_available=1
else
    echo "Warning: secrets library not found at $SECRETS_LIB — store checks unavailable" >&2
fi

has_line() { grep -qxF "$2" <<<"$1"; }

# Resolve requested names: exact key, or prefix over canonical ∪ store keys
all_known="$(printf '%s\n%s\n' "$canonical_keys" "$store_keys" | grep -v '^$' | sort -u)"
if [[ $# -gt 0 ]]; then
    keys=""
    unmatched=0
    for arg in "$@"; do
        if has_line "$all_known" "$arg"; then
            keys+="$arg"$'\n'
        else
            matches="$(grep -E "^${arg}" <<<"$all_known")"
            if [[ -n "$matches" ]]; then
                keys+="$matches"$'\n'
            else
                echo "Warning: no key matches '$arg' (checked as-is)" >&2
                keys+="$arg"$'\n'
                unmatched=1
            fi
        fi
    done
    keys="$(sort -u <<<"${keys%$'\n'}")"
else
    keys="$canonical_keys"
    unmatched=0
    if [[ -z "$keys" ]]; then
        echo "Error: no \$(secret KEY) references found in $EXPORTS_FILE" >&2
        exit 2
    fi
fi

broken=$unmatched
printf '%-38s %-10s %-16s %s\n' "KEY" "STORE" "EXPORTS" "ENV"
while IFS= read -r key; do
    [[ -z "$key" ]] && continue

    # EXPORTS: uncommented `export KEY=` line; derived = assigned from
    # another variable rather than read from the store itself
    export_line="$(grep -nE "^[[:space:]]*export ${key}=" "$EXPORTS_FILE" | grep -vE ':[[:space:]]*#' | head -1 | cut -d: -f1)"
    if [[ -n "$export_line" ]]; then
        if has_line "$canonical_keys" "$key"; then
            exports_col="L${export_line}"
            kind="direct"
        else
            exports_col="L${export_line} (derived)"
            kind="derived"
        fi
    else
        exports_col="MISSING"
        kind="absent"
    fi

    # STORE: n/a for derived vars (they alias another key's value)
    if [[ "$kind" == "derived" ]]; then
        store_col="n/a"
        store_ok=1
    elif [[ $store_available -eq 0 ]]; then
        store_col="unknown"
        store_ok=1
    elif has_line "$store_keys" "$key"; then
        store_col="ok"
        store_ok=1
    else
        store_col="MISSING"
        store_ok=0
    fi

    # ENV: non-empty in the inherited environment (empty counts as missing —
    # an export line whose $(secret ...) returned nothing still sets the var)
    if [[ -n "${!key-}" ]]; then
        env_col="set"
        env_ok=1
    else
        env_col="MISSING"
        env_ok=0
    fi

    [[ $store_ok -eq 1 && $env_ok -eq 1 && "$kind" != "absent" ]] || broken=1
    printf '%-38s %-10s %-16s %s\n' "$key" "$store_col" "$exports_col" "$env_col"
done <<<"$keys"

exit $broken
