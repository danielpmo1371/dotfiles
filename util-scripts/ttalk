#!/usr/bin/env bash
# ttalk — speak a short message aloud (task-completion notifications).
# Replaces the former Deepgram-based termtalk project: local TTS needs no
# API key or network, so notifications can never silently die on auth.
# Prefers Piper (neural voice, model at $PIPER_VOICE, default below) and falls
# back to the system engines when Piper, the model or an audio player is missing.
# Exits 0 even with no TTS engine available — callers (Claude sessions,
# scripts) must never fail because audio is missing.
#
# Playback is serialized machine-wide: several Claude sessions (tmux panes,
# sub-agents, parallel tool calls) finishing together used to speak over each
# other until none was intelligible. Each message now waits for a lock and
# plays alone. Piper synthesis runs before the lock so queued messages still
# play back-to-back. A message that cannot get the lock within TTALK_WAIT
# seconds is dropped — a notification that late is stale, and dropping bounds
# the queue.
#
# `ttalk --disable` / `ttalk --enable` mute or unmute every ttalk of this user
# (a JSON state file under XDG_STATE_HOME); a muted call exits 0 silently.
# `ttalk --volume N` stores the playback volume (0-100, percent of the system
# volume) in the same file; `ttalk --volume` prints it (default: DEFAULT_VOLUME).
# TTALK_LENGTH_SCALE / TTALK_SENTENCE_SILENCE tune Piper's pace and pauses.

set -u

TTALK_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/ttalk"
TTALK_STATE_FILE="$TTALK_STATE_DIR/state.json"
# Playback volume (percent of the system volume) until `ttalk --volume` sets one.
readonly DEFAULT_VOLUME=40
# Piper pacing: phoneme length multiplier (>1 speaks slower; voice default 1.0)
# and seconds of silence after each sentence (Piper default 0.2).
TTALK_LENGTH_SCALE="${TTALK_LENGTH_SCALE:-1.25}"
TTALK_SENTENCE_SILENCE="${TTALK_SENTENCE_SILENCE:-0.6}"

# Append one line to today's log in the state dir (best effort).
log_state() {
    { printf '%s - %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" \
        >> "$TTALK_STATE_DIR/$(date +%Y-%m-%d).log"; } 2>/dev/null
}

# Args: true|false volume
write_state() {
    mkdir -p "$TTALK_STATE_DIR" \
        && printf '{"isEnabled": %s, "volume": %s}\n' "$1" "$2" > "$TTALK_STATE_FILE" \
        || { echo "ttalk: could not write $TTALK_STATE_FILE" >&2; exit 1; }
}

# An integer percentage 0-100 (leading zeros allowed).
is_volume() {
    [[ "$1" =~ ^[0-9]+$ ]] && (( 10#$1 <= 100 ))
}

# Prints the stored volume, or DEFAULT_VOLUME when missing or invalid, so a
# hand-edited file can never make ttalk fail or go silent.
read_volume() {
    local v
    if command -v jq >/dev/null 2>&1; then
        v=$(jq -r '.volume // empty' "$TTALK_STATE_FILE" 2>/dev/null)
    else
        v=$({ grep -Eo '"volume"[[:space:]]*:[[:space:]]*[0-9]+' "$TTALK_STATE_FILE" \
            | grep -Eo '[0-9]+$'; } 2>/dev/null)
    fi
    if is_volume "${v:-}"; then echo "$((10#$v))"; else echo "$DEFAULT_VOLUME"; fi
}

# Anything but isEnabled == true mutes. An unparsable file leaves ttalk
# enabled: a lost notification is worse than an extra one. Without jq
# (older macOS) only the literal false that write_state writes mutes.
is_muted() {
    if command -v jq >/dev/null 2>&1; then
        jq -e '.isEnabled != true' "$TTALK_STATE_FILE" >/dev/null 2>&1
    else
        grep -Eq '"isEnabled"[[:space:]]*:[[:space:]]*false' "$TTALK_STATE_FILE" 2>/dev/null
    fi
}

usage() {
    echo "usage: ttalk <message> | ttalk --enable | ttalk --disable | ttalk --volume [0-100]" >&2
    exit 1
}

case "${1:-}" in
    --enable)  write_state true "$(read_volume)";  echo "ttalk enabled for this user.";  exit 0 ;;
    --disable) write_state false "$(read_volume)"; echo "ttalk disabled for this user."; exit 0 ;;
    --volume)
        if [[ $# -eq 1 ]]; then
            echo "ttalk volume: $(read_volume)%"
            exit 0
        fi
        [[ $# -eq 2 ]] || usage
        new_volume="${2%\%}"
        is_volume "$new_volume" || { echo "ttalk: volume must be an integer from 0 to 100" >&2; exit 1; }
        if is_muted; then enabled=false; else enabled=true; fi
        write_state "$enabled" "$((10#$new_volume))"
        echo "ttalk volume set to $((10#$new_volume))%."
        exit 0
        ;;
esac

# A missing state file means enabled; it is created so the settings are visible.
if [[ ! -f "$TTALK_STATE_FILE" ]]; then
    mkdir -p "$TTALK_STATE_DIR" 2>/dev/null \
        && printf '{"isEnabled": true, "volume": %s}\n' "$DEFAULT_VOLUME" > "$TTALK_STATE_FILE" 2>/dev/null \
        && log_state "No state file found. Created default state.json (enabled)."
elif is_muted; then
    log_state "ttalk disabled by state file; message not spoken."
    exit 0
fi

# Default voice; export PIPER_VOICE (e.g. in env.sh) to override. Kept here
# rather than only in env.sh so shells/sessions started before an env change,
# and non-login contexts (Hyprland binds, cron), still get the Piper voice.
PIPER_VOICE="${PIPER_VOICE:-${XDG_DATA_HOME:-$HOME/.local/share}/piper/voices/en_GB-cori-high.onnx}"

# Lock shared by every ttalk process of this user. XDG_RUNTIME_DIR is per-user
# and tmpfs (cleared at logout); TMPDIR is the per-user fallback on macOS.
TTALK_LOCK="${TTALK_LOCK:-${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/ttalk.lock}"
# Seconds a message waits for the speaker before it is dropped as stale.
TTALK_WAIT="${TTALK_WAIT:-120}"
# Poll interval (seconds) of the mkdir lock used where flock is unavailable.
readonly MKDIR_LOCK_POLL=0.2
# Exit status for "speaker busy past TTALK_WAIT" (EX_TEMPFAIL, sysexits.h). It
# must differ from an engine failure so a timed-out message is dropped rather
# than retried on the next engine.
readonly LOCK_TIMEOUT=75

msg="$*"
[[ -z "$msg" ]] && usage
volume=$(read_volume)

# Run "$@" while holding the speaker lock; returns LOCK_TIMEOUT without
# running it when the lock is not acquired within TTALK_WAIT seconds.
with_speaker_lock() {
    if command -v flock >/dev/null 2>&1; then
        # The kernel releases a flock when its holder dies, so a crashed or
        # killed ttalk can never wedge the queue.
        (
            flock -w "$TTALK_WAIT" 9 || exit "$LOCK_TIMEOUT"
            "$@"
        ) 9>"$TTALK_LOCK"
    else
        with_mkdir_lock "$@"
    fi
}

# Portable fallback (macOS ships no flock): mkdir is atomic. The holder's pid
# is recorded so a lock left behind by a killed process is reclaimed. It must
# be this subshell's pid, not $$ (the parent script, already exited); the
# child sh reports it as PPID because BASHPID needs bash 4 and macOS ships 3.2.
# Known limit: two waiters reclaiming the same stale lock at once can both
# proceed, so after a killed ttalk one pair of messages may overlap once;
# flock (Linux) has no such window.
with_mkdir_lock() {
    local dir="$TTALK_LOCK.d" holder status
    local deadline=$((SECONDS + TTALK_WAIT))
    until mkdir "$dir" 2>/dev/null; do
        holder=$(cat "$dir/pid" 2>/dev/null)
        if [[ -n "$holder" ]] && ! kill -0 "$holder" 2>/dev/null; then
            rm -rf "$dir"
            continue
        fi
        (( SECONDS >= deadline )) && return "$LOCK_TIMEOUT"
        sleep "$MKDIR_LOCK_POLL"
    done
    sh -c 'echo "$PPID"' >"$dir/pid"
    "$@"
    status=$?
    rm -rf "$dir"
    return "$status"
}

# volume as 0.00-1.00, for players whose scale is a linear fraction.
volume_fraction() {
    printf '%d.%02d' $((volume / 100)) $((volume % 100))
}

# Each player's own volume scale, derived from the 0-100 percentage.
play_wav() {
    if command -v pw-play >/dev/null 2>&1; then
        # Linear stream volume 0.0-1.0.
        pw-play --volume "$(volume_fraction)" "$1"
    elif command -v paplay >/dev/null 2>&1; then
        # Linear volume 0-65536.
        paplay --volume=$((volume * 65536 / 100)) "$1"
    else
        return 1
    fi
}

speak_piper() {
    command -v piper-tts >/dev/null 2>&1 || return 1
    [[ -f "${PIPER_VOICE:-}" ]] || return 1
    local wav status
    wav=$(mktemp "${TMPDIR:-/tmp}/ttalk.XXXXXX") || return 1
    if printf '%s' "$msg" | piper-tts -m "$PIPER_VOICE" -f "$wav" \
        --length_scale "$TTALK_LENGTH_SCALE" --sentence_silence "$TTALK_SENTENCE_SILENCE"; then
        with_speaker_lock play_wav "$wav"
        status=$?
    else
        status=1
    fi
    rm -f "$wav"
    return "$status"
}

# System engines synthesize and play in one step, so the lock covers both.
speak_system() {
    if command -v say >/dev/null 2>&1; then          # macOS
        # Embedded volume command, 0.0-1.0.
        say "[[volm $(volume_fraction)]] $msg"
    elif command -v espeak-ng >/dev/null 2>&1; then  # Linux
        # Amplitude 0-200, 100 = normal, so 100% keeps the engine default.
        espeak-ng -a "$volume" "$msg"
    elif command -v spd-say >/dev/null 2>&1; then    # Linux (speech-dispatcher)
        # -w waits until spoken; without it the lock would be released while
        # speech-dispatcher is still talking.
        # -i is -100..100 and speech-dispatcher's default volume is 100.
        spd-say -w -i $((volume * 2 - 100)) "$msg"
    fi
}

speak() {
    speak_piper
    case $? in
        0|"$LOCK_TIMEOUT") return ;;
    esac
    with_speaker_lock speak_system
}

# Background so the caller isn't blocked for the duration of the speech.
speak >/dev/null 2>&1 &

exit 0
