#!/bin/bash
# wall-pick
# Pick the FOCUSED Hyprland monitor's wallpaper visually, in the control hub's
# image picker (Omarchy's carousel), and apply it with an awww transition.
#
# Usage:
#   wall-pick [--favorites]
#
# Lists every collection dir under $WALLPAPER_DIR (or $WALL_FAVORITES_DIR with
# --favorites), opens on the current image, waits for the pick and applies it.
# Esc in the picker cancels and leaves the wallpaper alone (exit 1).
# Started from the hub's Wallpapers tile; needs the hub running (hub-shell).

set -uo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
# shellcheck source=util-scripts/wall-lib.sh
source "$SCRIPT_DIR/wall-lib.sh"

WALL_TRANSITION="${WALL_TRANSITION:-grow}"
WALL_TRANSITION_DURATION="${WALL_TRANSITION_DURATION:-1}"
# A pick nobody makes must not leave this waiting forever.
WALL_PICK_TIMEOUT="${WALL_PICK_TIMEOUT:-600}"
HUB_SHELL="${HUB_SHELL:-$SCRIPT_DIR/hub-shell}"

root="$WALLPAPER_DIR"
[[ ${1:-} == --favorites ]] && root="$WALL_FAVORITES_DIR"
[[ -d $root ]] || fail "no wallpaper dir at $root"

# The picker lists one directory level per entry: the root and each collection.
dirs=$(find -L "$root" -maxdepth 1 -type d -not -name '.*' -print | LC_ALL=C sort)

monitor=$(focused_monitor) || fail "no focused monitor (is Hyprland running?)"
current=$(current_image "$monitor" 2>/dev/null || true)

work=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/wall-pick.XXXXXX")
trap 'rm -rf "$work"' EXIT
selection="$work/selection"
done_file="$work/done"
: >"$selection"

payload=$(jq -cn --arg dirs "$dirs" --arg sel "$current" --arg selFile "$selection" --arg done "$done_file" \
    '{imageDirs: $dirs, selectedImage: $sel, selectionFile: $selFile, doneFile: $done, showLabels: false, filterable: true}')
"$HUB_SHELL" summon omarchy.image-picker "$payload" >/dev/null || fail "control hub not running (hub-shell start)"

waited=0
while [[ ! -e $done_file ]]; do
    (( waited >= WALL_PICK_TIMEOUT * 10 )) && fail "no wallpaper picked in ${WALL_PICK_TIMEOUT}s"
    sleep 0.1
    waited=$((waited + 1))
done

target=$(<"$selection")
[[ -n $target ]] || exit 1
awww img -o "$monitor" -t "$WALL_TRANSITION" --transition-duration "$WALL_TRANSITION_DURATION" "$target" \
    || fail "awww img failed for $target on $monitor"
